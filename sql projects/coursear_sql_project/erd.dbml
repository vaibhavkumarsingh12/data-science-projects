Table state_dim {
  State_ANSI integer [pk]
  Geo_Level text
}

Table commodity_dim {
  Commodity_ID integer [pk]
  Commodity_Name text
}

Table cheese_production {
  Record_ID integer [pk, increment]
  Year integer
  Period text
  State_ANSI integer
  Commodity_ID integer
  Domain text
  Value integer
}

Table honey_production {
  Record_ID integer [pk, increment]
  Year integer
  State_ANSI integer
  Commodity_ID integer
  Value integer
}


  Value integer
}

Table yogurt_production {
  Record_ID integer [pk, increment]
  Year integer
  Period text
  State_ANSI integer
  Commodity_ID integer
  Domain text
  Value integer
}

Ref: cheese_production.State_ANSI > state_dim.State_ANSI

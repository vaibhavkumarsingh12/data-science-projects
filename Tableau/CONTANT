<style>
  @import url('https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;600;700&family=Rajdhani:wght@400;600;700&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #1e2235;
    font-family: 'Exo 2', sans-serif;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #canvas-container {
    position: relative;
    width: 100vw;
    height: 100vh;
  }

  svg#mindmap {
    width: 100%;
    height: 100%;
  }

  .node-label {
    cursor: default;
    user-select: none;
  }

  .node-box {
    rx: 6;
    ry: 6;
    cursor: default;
  }

  .dot-btn {
    cursor: pointer;
    transition: r 0.2s;
  }
  .dot-btn:hover circle {
    r: 10;
  }

  /* Panel */
  #panel {
    position: fixed;
    top: 0; right: -480px;
    width: 460px;
    height: 100vh;
    background: #12151f;
    border-left: 2px solid #ffffff22;
    overflow-y: auto;
    transition: right 0.4s cubic-bezier(0.22,1,0.36,1);
    z-index: 100;
    padding: 0;
  }
  #panel.open { right: 0; }

  #panel-header {
    padding: 24px 24px 16px;
    border-bottom: 1px solid #ffffff15;
    position: sticky;
    top: 0;
    background: #12151f;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #panel-color-bar {
    width: 5px;
    height: 40px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  #panel-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 1px;
  }

  #close-btn {
    margin-left: auto;
    background: none;
    border: none;
    color: #888;
    font-size: 22px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
    transition: color 0.2s, background 0.2s;
  }
  #close-btn:hover { color: #fff; background: #ffffff15; }

  #panel-body { padding: 16px 24px 32px; }

  .topic-item {
    margin-bottom: 8px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #ffffff10;
  }

  .topic-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    background: #1a1f30;
    cursor: pointer;
    transition: background 0.2s;
  }
  .topic-header:hover { background: #222840; }

  .topic-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .topic-name {
    font-size: 13.5px;
    color: #d0d8f0;
    font-weight: 500;
    flex: 1;
  }

  .topic-time {
    font-size: 11px;
    color: #5a6480;
    font-family: monospace;
  }

  .topic-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 6px 14px 10px 32px;
    font-size: 12px;
    color: #5a7aff;
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 4px;
    background: #5a7aff12;
    border: 1px solid #5a7aff30;
    transition: background 0.2s;
  }
  .topic-link:hover { background: #5a7aff25; }

  .section-desc {
    font-size: 12.5px;
    color: #6a7090;
    padding: 6px 14px 12px 32px;
    line-height: 1.6;
  }

  /* Center label */
  .center-text {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    fill: #ffffff;
    font-size: 20px;
    text-anchor: middle;
    dominant-baseline: middle;
    letter-spacing: 1.5px;
    pointer-events: none;
  }
</style>

  const s = sections[key];
  if (!s) return;

  document.getElementById('panel-title').textContent = s.title;
  document.getElementById('panel-color-bar').style.background = s.color;

  let html = `<p class="section-desc" style="padding: 4px 0 16px 0; color:#8090b0; font-size:13px; line-height:1.65;">${s.desc}</p>`;

  s.topics.forEach(tp => {
    const url = `https://www.youtube.com/watch?v=K3pXnbniUcM&t=${tp.ts}s`;
    html += `
      <div class="topic-item">
        <div class="topic-header">
          <div class="topic-dot" style="background:${s.color}"></div>
          <span class="topic-name">${tp.name}</span>
          <span class="topic-time">${tp.time}</span>
        </div>
        <a class="topic-link" href="${url}" target="_blank">
          ▶ Watch on YouTube
        </a>
      </div>`;
  });

  document.getElementById('panel-body').innerHTML = html;
  document.getElementById('panel').classList.add('open');
}

function closePanel() {
  document.getElementById('panel').classList.remove('open');
}
</script>
</body>
</html>
